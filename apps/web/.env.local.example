# Server-side (Server Components, route handlers) — FastAPI base URL
API_URL=http://localhost:8000

# Client-side fallback, only if you ever fetch the API from the browser directly
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase project settings (Settings -> API in the Supabase dashboard) — the
# anon/public key is safe to expose client-side, this is the intended use.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-public-key
