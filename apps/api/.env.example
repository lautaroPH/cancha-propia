# Supabase project settings (Settings -> API / Database in the Supabase dashboard)
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Settings -> API -> JWT Settings -> "JWT Secret" — a plain random string, NOT
# the anon or service_role key (those are themselves JWTs, easy to mix up).
# Used to verify the session tokens Supabase issues on login.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Settings -> API -> "service_role" key — server-only, never expose this to
# the frontend. Used solely by app/promote_admin.py to look up a user by email.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Used to salt the national-ID hash stored for duplicate detection (plan §2) — never log or expose this
SECURITY_PEPPER=replace-with-a-long-random-string

# S3 (file storage — kept separate from Supabase on purpose, see plan §11)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_BUCKET_NAME=codeportistas-uploads

# CORS
WEB_ORIGIN=http://localhost:3000

# Notification emails (application received/approved/rejected/etc), sent via
# a dedicated Gmail account's SMTP relay — no domain or third-party service
# needed. Create an app password at myaccount.google.com/apppasswords (needs
# 2-Step Verification on first) — NOT the account's real login password.
# Leave SMTP_USER/PASSWORD blank to skip sending (logged instead) — fine for
# local dev.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-your-gmail-address
SMTP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM=Codeportistas <replace-with-your-gmail-address>

# Local dev only — lets you switch test accounts instantly without waiting on
# Supabase's email rate limit. NEVER set this true anywhere but your own machine.
DEV_AUTH_ENABLED=false
